<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="derico.blicca.listingfilters">

  <genericsetup:registerProfile
      name="1001"
      title="derico.blicca.listingfilters: upgrade to 1001"
      directory="1001"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:upgradeSteps
      source="1000"
      destination="1001"
      profile="derico.blicca.listingfilters:default">

    <genericsetup:upgradeStep
        title="Register the listing override"
        description="A custom upgrade step"
        handler=".v1001.upgrade"
        />

    <genericsetup:upgradeDepends
        title="Apply profile version 1001"
        import_profile="derico.blicca.listingfilters.upgrades:1001"
        />

  </genericsetup:upgradeSteps>

</configure>
