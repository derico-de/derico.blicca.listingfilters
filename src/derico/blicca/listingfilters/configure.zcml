<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="derico.blicca.listingfilters">

  <i18n:registerTranslations directory="locales" />

  <include file="permissions.zcml" />

  <genericsetup:registerProfile
      name="default"
      title="Derico Blicca Listingfilters"
      description="Listing filters for Plone Blicca: visitors narrow a listing by tags, other properties or a text search, with options from that listing&#39;s own results"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="Derico Blicca Listingfilters (uninstall)"
      description="Uninstalls derico.blicca.listingfilters"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/uninstall"
      />

  <!-- `++plone++`, never `++resource++`: two URLs for one JS module are two
       module instances, hence two Reacts (block add-on contract §3.1). -->
  <plone:static
      name="derico.blicca.listingfilters"
      type="plone"
      directory="static"
      />

  <genericsetup:importStep
      name="derico.blicca.listingfilters-uninstall"
      title="Derico Blicca Listingfilters uninstall"
      description="Uninstall derico.blicca.listingfilters"
      handler="derico.blicca.listingfilters.setuphandlers.uninstall"
      />

  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="derico.blicca.listingfilters-hiddenprofiles"
      />


  <include package=".views" />

</configure>
